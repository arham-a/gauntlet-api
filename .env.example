# ---- Local development ----
PORT=5000
NODE_ENV=development

# Local MongoDB (Docker container: competiconnect-mongo)
# index.js reads MONGODB_URI; constants/index.js reads MONGO_URI. Keep both in sync.
MONGODB_URI=mongodb://localhost:27017/competiconnect  # or your Atlas SRV string
MONGO_URI=mongodb://localhost:27017/competiconnect  # or your Atlas SRV string

JWT_SECRET=replace_with_a_long_random_string

# ---- Optional: image uploads (cloudinary.com) ----
# Competition/profile image upload fails until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Optional: outbound email (Gmail app password) ----
# Email notifications fail until these are set.
EMAIL_USER=
EMAIL_PASS=